flowchart TB
    subgraph CLIENTES["1 · Clientes"]
        direction LR
        UI["UI web / app<br/>conversacional"]
        EXT["Sistemas externos<br/>webhooks · cron"]
    end

    subgraph BORDE["2 · Borde"]
        direction LR
        WAF["AWS WAF +<br/>CloudFront"]
        APIGW["API Gateway<br/>REST · WebSocket"]
        COGNITO["Amazon Cognito<br/>OAuth 2.0 · JWT"]
        SQS["Amazon SQS<br/>cola + DLQ"]
    end

    subgraph NUCLEO["3 · Núcleo de orquestación (Bedrock AgentCore)"]
        direction LR
        RT["AgentCore<br/>Runtime"]
        GR["Bedrock<br/>Guardrails"]
        MEM["AgentCore<br/>Memory"]
        GW["AgentCore<br/>Gateway"]
        SF["Step Functions +<br/>aprobación humana"]
    end

    subgraph TOOLS["4 · Herramientas"]
        direction LR
        LAMBDA["AWS Lambda"]
        FARGATE["Workers Fargate"]
    end

    subgraph DATOS["5 · Conocimiento y datos"]
        direction LR
        KB["Knowledge Bases +<br/>OpenSearch"]
        DDB["DynamoDB<br/>sesiones · tareas"]
        AURORA["Aurora PostgreSQL<br/>transaccional"]
        S3["Amazon S3<br/>documentos · bitácora"]
    end

    subgraph SEG["6 · Seguridad y observabilidad (transversal)"]
        direction LR
        KMS["KMS +<br/>Secrets Manager"]
        IAM["IAM ·<br/>AgentCore Identity"]
        OBS["CloudWatch +<br/>X-Ray"]
    end

    UI -->|HTTPS / WSS| WAF --> APIGW
